# Conexión a SQL Server (instancia local, sin puerto explícito)
DB_SERVER=.\SQLEXPRESS
DB_NAME=SIGIH
DB_DRIVER=ODBC Driver 18 for SQL Server

# Credenciales de autenticación de SQL Server (completar en .env)
DB_USER=
DB_PASSWORD=

# Autenticación JWT (completar en .env, nunca versionar el valor real)
# Generar con: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRACION_MINUTOS=60
